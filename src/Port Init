/*
 * port_init.c - GPIO port initialization
 *
 * All peripheral pin configurations are centralized here.
 * Each function enables the port clock, configures AMSEL/PCTL/DIR/AFSEL/DEN,
 * and sets initial output states.
 *
 * JTAG WARNING: PC0-PC3 are reserved for JTAG/SWD. Never configure them.
 */

#include "port_init.h"
#include "tm4c123gh6pm.h"

/* ============================================================================
 * PortA_Init
 * PA2/PA3 - Motor A direction (GPIO outputs)
 * PA4     - Servo PWM (bit-bang, GPIO output)
 * PA5/PA6 - Motor B direction (GPIO outputs)
 * ============================================================================ */
void PortA_Init(void) {
    volatile unsigned long delay;
    SYSCTL_RCGC2_R |= 0x01;
    delay = SYSCTL_RCGC2_R;

    GPIO_PORTA_AMSEL_R &= ~0x7C;
    GPIO_PORTA_PCTL_R  &= ~0x0FFFFF00;
    GPIO_PORTA_DIR_R   |=  0x7C;
    GPIO_PORTA_AFSEL_R &= ~0x7C;
    GPIO_PORTA_DEN_R   |=  0x7C;
    GPIO_PORTA_DATA_R  &= ~0x7C;
}

/* ============================================================================
 * PortB_Init
 * PB2 - Echo input  (T3CCP0, AF7)
 * PB3 - Trigger out (GPIO output)
 * PB4 - Motor A PWM (M0PWM2, AF4)
 * PB5 - Motor B PWM (M0PWM3, AF4)
 * ============================================================================ */
void PortB_Init(void) {
    volatile unsigned long delay;
    SYSCTL_RCGC2_R |= 0x02;
    delay = SYSCTL_RCGC2_R;

    GPIO_PORTB_AMSEL_R &= ~0x3C;

    GPIO_PORTB_PCTL_R &= ~0x00FFFF00;
    GPIO_PORTB_PCTL_R |=  0x00440700;   /* PB2=AF7(T3CCP0), PB4/5=AF4(PWM) */

    GPIO_PORTB_DIR_R  &= ~0x04;         /* PB2 input                        */
    GPIO_PORTB_DIR_R  |=  0x38;         /* PB3, PB4, PB5 outputs            */
    GPIO_PORTB_AFSEL_R|=  0x34;         /* AF on PB2, PB4, PB5              */
    GPIO_PORTB_AFSEL_R&= ~0x08;         /* PB3 plain GPIO                   */
    GPIO_PORTB_DEN_R  |=  0x3C;
    GPIO_PORTB_DATA_R &= ~0x08;         /* Trigger low initially             */
}

/* ============================================================================
 * PortC_Init
 * PC4-PC7 - LCD D4-D7 (GPIO outputs)
 * PC0-PC3 NOT TOUCHED (JTAG)
 * ============================================================================ */
void PortC_Init(void) {
    volatile unsigned long delay;
    SYSCTL_RCGC2_R |= 0x04;
    delay = SYSCTL_RCGC2_R;

    GPIO_PORTC_AMSEL_R &= ~0xF0;
    GPIO_PORTC_PCTL_R  &= ~0xFFFF0000;
    GPIO_PORTC_DIR_R   |=  0xF0;
    GPIO_PORTC_AFSEL_R &= ~0xF0;
    GPIO_PORTC_DEN_R   |=  0xF0;
    GPIO_PORTC_DATA_R  &= ~0xF0;
}

/* ============================================================================
 * PortD_Init
 * PD0-PD2 - LCD RS/RW/E (GPIO outputs)
 * PD3     - TMP36 (AIN4, analog input)
 * ============================================================================ */
void PortD_Init(void) {
    volatile unsigned long delay;
    SYSCTL_RCGC2_R |= 0x08;
    delay = SYSCTL_RCGC2_R;

    GPIO_PORTD_AMSEL_R &= ~0x07;
    GPIO_PORTD_PCTL_R  &= ~0x00000FFF;
    GPIO_PORTD_DIR_R   |=  0x07;
    GPIO_PORTD_AFSEL_R &= ~0x07;
    GPIO_PORTD_DEN_R   |=  0x07;
    GPIO_PORTD_DATA_R  &= ~0x07;

    /* PD3: analog input for ADC */
    GPIO_PORTD_AFSEL_R |=  0x08;
    GPIO_PORTD_DEN_R   &= ~0x08;
    GPIO_PORTD_AMSEL_R |=  0x08;
}

/* ============================================================================
 * PortE_Init
 * PE4 - UART5 RX (AF1)
 * PE5 - UART5 TX (AF1)
 * ============================================================================ */
void PortE_Init(void) {
    volatile unsigned long delay;
    SYSCTL_RCGC2_R |= 0x10;
    delay = SYSCTL_RCGC2_R;

    GPIO_PORTE_AMSEL_R &= ~0x30;
    GPIO_PORTE_PCTL_R  &= ~0x00FF0000;
    GPIO_PORTE_PCTL_R  |=  0x00110000;  /* PE4=U5Rx, PE5=U5Tx (AF1)        */
    GPIO_PORTE_DEN_R   |=  0x30;
    GPIO_PORTE_AFSEL_R |=  0x30;
}

/* ============================================================================
 * PortF_Init
 * PF1 - Red LED
 * PF2 - Blue LED
 * PF3 - Green LED (heartbeat)
 * ============================================================================ */
void PortF_Init(void) {
    SYSCTL_RCGC2_R |= 0x20;
    volatile unsigned long delay = SYSCTL_RCGC2_R;
    GPIO_PORTF_DIR_R  |= 0x0E;
    GPIO_PORTF_DEN_R  |= 0x0E;
    GPIO_PORTF_DATA_R  = 0x00;
}
